# ==============================================================================
# IQROLIFE & ERP KSS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GantiPasswordPostgresKalian123!

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_kss_school_finance_key_minimum_32_characters
IQROLIFE_JWT_SECRET=super_secret_jwt_iqrolife_web_community_key_min_32_chars

# Cloudinary Storage (For Payment Proofs & Evidence Photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# MinIO file storage (service "minio", API http://minio:9000 inside the Docker network)
# Root account is for administration only; apps use their own keys below.
MINIO_ROOT_USER=iqrolife-admin
MINIO_ROOT_PASSWORD=change_me_openssl_rand_hex_24
# Per-app keys; minio-init creates bucket <app> and a key that can only touch it.
# Leave an app's pair empty to skip it. Secret: openssl rand -hex 24
FTD_S3_ACCESS_KEY=ftd-app
FTD_S3_SECRET_KEY=
KSS_S3_ACCESS_KEY=
KSS_S3_SECRET_KEY=
IQROLIFE_S3_ACCESS_KEY=
IQROLIFE_S3_SECRET_KEY=

# Let's Encrypt SSL Email (Configured inside Caddyfile)
ACME_EMAIL=admin@iqrolife.id

# Shared secret between iqrolife-web and iqrolife-notif (long random string, e.g. openssl rand -hex 32)
NOTIFICATION_API_KEY=change_me_long_random_string

# Gmail account iqrolife-notif sends from (16-char Google App Password, not the account password)
GMAIL_USER=iqrolife@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Shared secret for the PPDB -> KSS enrollment handoff (kss-backend and iqrolife-backend).
# Leave empty to keep the integration off; openssl rand -hex 32 to enable.
PPDB_INTEGRATION_API_KEY=
